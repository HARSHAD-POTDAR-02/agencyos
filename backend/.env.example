# ==============================================================================
# AgencyOS Backend - Production Environment Variables Example
# ==============================================================================

# Application Environment ('production' or 'development')
APP_ENV=production

# Database (Neon Serverless PostgreSQL or standard PostgreSQL)
# Async format (for asyncpg):
DATABASE_URL=postgresql+asyncpg://neondb_owner:<password>@<endpoint>-pooler.c-15.us-east-1.aws.neon.tech/neondb?ssl=require
# Sync format (for Alembic migrations):
SYNC_DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint>-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Object Storage: Backblaze B2 (S3-Compatible API with Presigned URLs)
STORAGE_BACKEND=b2
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_KEY_ID=005<your-account-id>0000000001
B2_APPLICATION_KEY=your-backblaze-application-key
B2_BUCKET_NAME=agencyos-bucket
B2_REGION=us-east-005
B2_PRESIGNED_EXPIRATION_SECONDS=86400

# S3 Fallback (if using MinIO or AWS S3 directly)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agencyos-assets
S3_REGION=us-east-005

# Local Upload Fallback Directory
UPLOAD_DIR=uploads

# External Public URLs
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=https://api.yourdomain.com

# Meta Graph API Integration (Instagram & Facebook Publishing)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://api.yourdomain.com/social/meta/callback

# AI & LLM Model Providers
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama-3.1-8b-instant
NVIDIA_API_KEY=nvapi-your_nvidia_api_key
TAVILY_API_KEY=tvly-your_tavily_api_key
