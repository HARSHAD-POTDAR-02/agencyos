# ==============================================================================
# AgencyOS Root Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to `.env` before running:
#   docker compose -f docker-compose.prod.yml up --build -d
# ==============================================================================

# Database: Neon Serverless PostgreSQL
DATABASE_URL=postgresql+asyncpg://neondb_owner:<password>@<endpoint>-pooler.c-15.us-east-1.aws.neon.tech/neondb?ssl=require
SYNC_DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint>-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require

# Authentication
SECRET_KEY=generate-with-openssl-rand-hex-32

# Storage: Backblaze B2 (S3-Compatible API)
STORAGE_BACKEND=b2
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_KEY_ID=005<your-account-id>0000000001
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=agencyos-bucket
B2_REGION=us-east-005

# Frontend & Backend Networking
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# AI Services
GROQ_API_KEY=
TAVILY_API_KEY=
NVIDIA_API_KEY=

# Meta Graph API
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
